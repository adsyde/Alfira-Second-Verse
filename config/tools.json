{
  "_local_config": "Машинно-зависимые пути задаются в config/tools.local.json (см. tools.local.example.json). Этот файл общий.",
  "game": "bg3",
  "game_version": "Patch 8 Hotfix 9",
  "mod": {
    "name": "AlfiraSecondVerse",
    "display_name": "Alfira: Second Verse",
    "uuid": "d2bf8bd7-0c6e-4aa5-8c78-84ae31e14f5b",
    "_uuid_note": "Выдан один раз при создании проекта. Не менять: иначе для игрока это другой мод.",
    "author": "adsyde",
    "version": "0.9.0"
  },
  "alfira": {
    "_note": "Идентификаторы Альфиры в игре. Заполняет scripts/find_alfira.py, руками не править.",
    "display_name_handles": [],
    "templates": [],
    "characters": []
  },
  "unpack": {
    "_note": "Что достаём из паков игры в game-data/ (в git не попадает). Шаблоны — glob Divine по пути внутри пака.",
    "sets": {
      "goals": {
        "paks": [
          "Shared.pak",
          "Gustav.pak",
          "GustavX.pak",
          "Patch8_HotFix9.pak"
        ],
        "expressions": [
          "*/Story/RawFiles/Goals/*.txt"
        ]
      },
      "dialogs-alfira": {
        "paks": [
          "Gustav.pak",
          "GustavX.pak"
        ],
        "expressions": [
          "*Story/Dialogs/*Alfira*.lsj",
          "*Story/Dialogs/Act1/DEN/*Bard*.lsj",
          "*Story/Dialogs/*Lakrissa*.lsj"
        ]
      },
      "dialogs-companions": {
        "paks": [
          "Gustav.pak",
          "GustavX.pak"
        ],
        "expressions": [
          "*Story/Dialogs/Companions/*.lsj"
        ]
      },
      "stats": {
        "paks": [
          "Shared.pak",
          "Gustav.pak",
          "GustavX.pak",
          "Patch8_HotFix9.pak"
        ],
        "expressions": [
          "*/Stats/Generated/Data/*.txt",
          "*/Stats/Generated/*.txt"
        ]
      },
      "templates": {
        "paks": [
          "Shared.pak",
          "Gustav.pak",
          "GustavX.pak",
          "Patch8_HotFix9.pak"
        ],
        "expressions": [
          "*/RootTemplates/_merged.lsf",
          "*/Globals/*/Characters/*.lsf",
          "*/Levels/*/Characters/*.lsf"
        ],
        "convert": "lsx"
      },
      "voicemeta": {
        "paks": [
          "Localization/VoiceMeta.pak"
        ],
        "expressions": [
          "*"
        ]
      },
      "loca": {
        "paks": [
          "Localization/English.pak",
          "Localization/Russian/Russian.pak"
        ],
        "expressions": [
          "*.loca"
        ]
      },
      "flags": {
        "paks": [
          "Shared.pak",
          "Gustav.pak",
          "GustavX.pak"
        ],
        "expressions": [
          "Public/*/Flags/*.lsf",
          "Public/*/Tags/*.lsf"
        ],
        "convert": "lsx"
      },
      "dialogs-all": {
        "paks": [
          "Gustav.pak",
          "GustavX.pak",
          "Patch8_HotFix9.pak"
        ],
        "expressions": [
          "*Story/Dialogs/*.lsj"
        ],
        "_note": "~9200 файлов, 1.8 ГБ. Нужно для поиска всех сцен, где участвует Альфира, и реплик спутников о ней."
      },
      "approval": {
        "paks": [
          "Shared.pak",
          "Gustav.pak",
          "GustavX.pak",
          "Patch8_HotFix9.pak"
        ],
        "expressions": [
          "Public/*/ApprovalRatings/*"
        ],
        "convert": "lsx",
        "_note": "Ресурсы реакций одобрения: какой узел диалога сколько даёт каждому спутнику."
      },
      "portraits": {
        "paks": [
          "Game.pak",
          "Shared.pak",
          "Gustav.pak",
          "GustavX.pak",
          "Gustav_Textures.pak",
          "Patch8_HotFix9.pak"
        ],
        "expressions": [
          "*/GUI/Assets/Portraits/*",
          "*/GUI/metadata.lsf"
        ],
        "convert": "lsx",
        "_note": "Портреты персонажей (DDS, имя = Icon шаблона + .DDS) и metadata.lsf интерфейса: docs/PORTRAITS.md."
      },
      "progression": {
        "paks": [
          "Shared.pak",
          "Gustav.pak",
          "GustavX.pak",
          "Patch8_HotFix9.pak"
        ],
        "expressions": [
          "Public/*/Origins/*",
          "Public/*/Progressions/*",
          "Public/*/ClassDescriptions/*",
          "Public/*/Lists/*",
          "Public/*/CharacterCreationPresets/*",
          "Public/*/DefaultValues/*",
          "Public/*/Races/*",
          "Public/*/Backgrounds/*",
          "Public/*/Feats/*",
          "Public/*/Levelmaps/*"
        ],
        "_note": "Билд спутников: Origins, прогрессии, классы, списки заклинаний, пресеты характеристик (AbilityDistributionPresets), DefaultValues (выборы по умолчанию): docs/STAGE3.md."
      }
    }
  },
  "paths": {
    "game_data": "game-data",
    "reports": "reports",
    "mod_src": "mod",
    "build": "build",
    "dist": "dist",
    "voice_work": "voice-work"
  }
}
