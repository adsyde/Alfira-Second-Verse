# --- Данные игры (права Larian): только локально ---
game-data/
# Распечатки диалогов игры: полный текст Larian
reports/dialogs/
# Каталог постановки Альфиры (scripts/dialogs/alfira_catalog.py): ремарки и тексты Larian
reports/staging/

# --- Голос: записи актрисы, модели и сгенерированное аудио ---
voice-work/

# --- Машинно-зависимые настройки ---
config/*.local.json
!config/*.local.example.json
.claude/settings.local.json
.env

# --- Производные артефакты сборки ---
build/
dist/
# Генератор диалогов (scripts/dialogs/build.py) собирает это из данных игры при каждой сборке:
# постановка (таймлайны, сцены, камеры Larian) и её банк, переопределение персонажа Альфиры.
mod/Public/_MOD_/Timeline/
mod/Public/_MOD_/Content/Generated/
mod/Mods/_MOD_/Globals/

# --- Python ---
__pycache__/
*.pyc

# --- .NET (scripts/osiheader) ---
bin/
obj/

# --- Рабочие копии агентов Claude Code ---
.claude/worktrees/
