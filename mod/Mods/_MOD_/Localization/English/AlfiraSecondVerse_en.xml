<?xml version="1.0" encoding="utf-8"?>
<contentList>
	<content contentuid="hff1bbd72g07d3g4281gb327g34817b837e83" version="1">[PH] Lihala's song is finished - because of you. I don't want to stop at one song. Could I come with you?</content>
	<content contentuid="hd92d2b3egac47g48d9g876ag916d74fe9295" version="1">[PH] Come with me.</content>
	<content contentuid="hd39e6e77g1718g4657g86c4g4ac9d4bd481f" version="1">[PH] Really? Then I'll try not to trip over my own lute.</content>
	<content contentuid="h6c8c204dgb6c7g4c63g84dag46fe637f460a" version="1">[PH] I'll find your camp and wait for you there.</content>
	<content contentuid="h254860ebgf451g46a3gad4fg160acef81e95" version="1">[PH] Not now.</content>
	<content contentuid="h49d5dd50g9fd0g49fbg80b6g3df80e4f0200" version="1">[PH] Of course. I'll be here, practising.</content>
	<content contentuid="h0c24c42agc266g4164g9c64g1dcad5626bcd" version="1">[PH] Need something?</content>
	<content contentuid="h9521d987gd66eg43cdga650g4c4535bedba9" version="1">[PH] Right behind you.</content>
	<content contentuid="h7f337a0cg2b51g415eg81e2g1be6ddee8ab3" version="1">[PH] Wait for me at camp.</content>
	<content contentuid="ha7e7a35agd798g4139g9931ga42992d9f190" version="1">[PH] I'll keep the fire going.</content>
	<content contentuid="h68f0ecbbga5fag4f72gbd7eg6d193f2c7d5a" version="1">[PH] &lt;i&gt;Leave.&lt;/i&gt;</content>
</contentList>
